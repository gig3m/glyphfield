HUD_BG = "\x1b[48;2;12;12;24m"
HUD_FG = "\x1b[38;2;200;200;215m"
HUD_DIM = "\x1b[38;2;110;110;135m"
HUD_HI = "\x1b[48;2;40;44;90m\x1b[38;2;255;255;255m"
HUD_W = 56


def slider(v, lo, hi, width=12):
    t = 0.0 if hi == lo else (v - lo) / (hi - lo)
    n = int(round(max(0.0, min(1.0, t)) * (width - 1)))
    return "━" * n + "●" + "─" * (width - 1 - n)


def draw_hud(style, st, sel, stats, flash):
    """The overlay, as cursor moves and text. Each line is a list of
    (colour, text) segments padded to HUD_W; returns (string, row count)."""
    lines = []
    tabs = "  ".join(("[%s]" % x) if x == style else (" %s " % x) for x in STYLES)
    lines.append([(HUD_FG, " glyphfield tuner   " + tabs)])
    lines.append([(HUD_DIM, " " + stats)])
    lines.append([])
    for i, (k, label, _, lo, hi, step, fmt, _) in enumerate(params_for(style)):
        v = st[k]
        if fmt == "bool":
            val, bar = ("on" if v else "off"), ("[x]" if v else "[ ]").ljust(12)
        else:
            val, bar = fmt % v, slider(v, lo, hi)
        base = HUD_HI if i == sel else HUD_FG
        if k.startswith("w_"):
            hx = MIRROR_COLORS[dict(WEIGHT_KEYS)[k[2:]]]
            seg = [(base, " "), (base + "\x1b[38;2;%d;%d;%dm" % parse_hex(hx), "■"),
                   (base, " %-24s %s %6s" % (k[2:], bar, val))]
        else:
            seg = [(base, " %-26s %s %6s" % (label, bar, val))]
        lines.append(seg)
    lines.append([])
    lines.append([(HUD_DIM, " ↑↓ pick  ←→ adjust  [ ] ×5  tab style  space toggle")])
    lines.append([(HUD_DIM, " r reset one  R reset style  s save  h hide  q quit")])
    if flash:
        lines.append([("\x1b[38;2;120;230;150m", " " + flash)])
    buf = []
    for row, segs in enumerate(lines):
        buf.append("\x1b[%d;1H%s" % (row + 1, HUD_BG))
        used = 0
        for color, text in segs:
            text = text[:HUD_W - used]
            buf.append(HUD_BG + color + text)
            used += len(text)
        buf.append(HUD_BG + " " * (HUD_W - used))
    buf.append("\x1b[0m")
    return "".join(buf), len(lines)


def read_keys(fd):
    """Drain pending input into key names."""
    data = os.read(fd, 256).decode("utf-8", "replace")
    keys = []
    i = 0
    seqs = {"\x1b[A": "up", "\x1b[B": "down", "\x1b[C": "right", "\x1b[D": "left",
            "\x1bOA": "up", "\x1bOB": "down", "\x1bOC": "right", "\x1bOD": "left",
            "\x1b[Z": "backtab"}
    while i < len(data):
        for seq, name in seqs.items():
            if data.startswith(seq, i):
                keys.append(name)
                i += len(seq)
                break
        else:
            ch = data[i]
            keys.append({"\t": "tab", "\x1b": "esc", " ": "space", "\x03": "q"}.get(ch, ch))
            i += 1
    return keys


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="glyphfield",
        description="Full-screen glyph grid driven by a looping geometric pattern. "
                    "Defaults come from " + CONFIG + "; flags override it.")
    ap.add_argument("--style", default=None, choices=STYLES,
                    help="kaleido: swirling kaleidoscope; mirror: beads streaming out "
                         "of a four-way mirror; bloom: rings breathing from the centre")
    ap.add_argument("--tune", action="store_true",
                    help="live settings overlay; keys adjust, s saves to the config")
    ap.add_argument("--period", type=float, help="seconds per base cycle; lower is faster")
    ap.add_argument("--jitter", type=float,
                    help="fraction of cells that flicker to a neighbouring glyph each frame")
    ap.add_argument("--steady", action="store_true", default=None,
                    help="constant pace and an exact loop, no surges")
    ap.add_argument("--fps", type=int, help="frame rate cap")
    ap.add_argument("--folds", type=int, help="mirror sectors (mirror: 4, or 8 for the diagonal)")
    ap.add_argument("--scale", type=float, help="zoom; >1 packs more pattern on screen")
    ap.add_argument("--pitch", type=int, help="columns per glyph; 2 makes a square dot grid")
    ap.add_argument("--aspect", type=float, default=2.22,
                    help="cell height:width ratio (default: 2.22)")
    args = ap.parse_args()

    cfg = load_config()
    settings = {}
    for stl in STYLES:
        st = dict(STYLE_DEFAULTS[stl])
        for k, v in (cfg.get(stl) or {}).items():
            if k in st:
                st[k] = type(st[k])(v) if not isinstance(st[k], bool) else bool(v)
        settings[stl] = st
    style = args.style or (cfg.get("style") if cfg.get("style") in STYLES else "kaleido")
    for k in ("period", "jitter", "steady", "fps", "folds", "scale", "pitch"):
        v = getattr(args, k)
        if v is not None:
            settings[style][k] = v

    out = sys.stdout
    fd = sys.stdin.fileno()
    interactive = sys.stdin.isatty() and not os.environ.get("SCREENSAVER_MANAGED")
    tune = args.tune and sys.stdin.isatty()
    saved = None

    resized = [False]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))

    def bail(*_):
        raise SystemExit(0)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, bail)

    try:
        if interactive or tune:
            saved = termios.tcgetattr(fd)
            tty.setcbreak(fd)

        out.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b]11;rgb:00/00/00\x07\x1b[2J")
        out.flush()

        wait_for_real_size()
        cols, rows = term_size()
        st = settings[style]
        field = make_field(style, cols, rows, args.aspect, st)
        colors = make_colors(style)
        prev = None
        start = time.monotonic()
        rng = random.Random()
        # tuner state
        sel, hud, flash, flash_until = 0, True, "", 0.0
        hud_rows = 0
        fps_seen, frames, fps_t = 0.0, 0, time.monotonic()
        rebuild = False

        while True:
            if (interactive or tune) and select.select([fd], [], [], 0)[0]:
                if not tune:
                    break
                plist = params_for(style)
                quit_ = False
                for key in read_keys(fd):
                    k, label, _, lo, hi, step, fmt, structural = plist[sel]
                    if key in ("q", "esc"):
                        quit_ = True
                    elif key == "up":
                        sel = (sel - 1) % len(plist)
                    elif key == "down":
                        sel = (sel + 1) % len(plist)
                    elif key in ("left", "right", "[", "]", "space"):
                        if fmt == "bool":
                            st[k] = not st[k]
                        else:
                            d = step * (5 if key in "[]" else 1) * (-1 if key in ("left", "[") else 1)
                            v = min(hi, max(lo, st[k] + d))
                            st[k] = int(round(v)) if fmt == "%d" else round(v, 4)
                        rebuild = rebuild or structural
                    elif key in ("tab", "backtab") or key in ("1", "2", "3"):
                        if key in ("1", "2", "3"):
                            style = STYLES[int(key) - 1]
                        else:
                            style = STYLES[(STYLES.index(style) + (1 if key == "tab" else -1)) % 3]
                        st = settings[style]
                        colors = make_colors(style)
                        sel = 0
                        rebuild = True
                    elif key == "r":
                        st[k] = STYLE_DEFAULTS[style][k]
                        rebuild = rebuild or structural
                    elif key == "R":
                        settings[style] = st = dict(STYLE_DEFAULTS[style])
                        rebuild = True
                    elif key == "h":
                        hud = not hud
                        prev = None
                    elif key == "s":
                        save_config(style, settings)
                        flash, flash_until = "saved to " + CONFIG.replace(os.path.expanduser("~"), "~"), time.monotonic() + 3
                if quit_:
                    break
            now = time.monotonic()
            if resized[0] or rebuild:
                if resized[0]:
                    cols, rows = term_size()
                resized[0] = rebuild = False
                field = make_field(style, cols, rows, args.aspect, st)
                prev = None
                out.write("\x1b[0m\x1b[2J")

            period = st["period"]
            ph = (now - start) / period
            if not st["steady"]:
                # Irrational-rate wobble on the clock: motion surges and
                # lulls, and the pattern never lands on the same frame twice.
                # Amplitudes are sized from the rate, 1 + 0.3cos + 0.15cos,
                # so pace swings 0.55x..1.45x and never stalls or reverses.
                ph += (0.3 / (TAU * 0.618) * math.sin(ph * TAU * 0.618)
                       + 0.15 / (TAU * 0.271) * math.sin(ph * TAU * 0.271 + 1.0))
            cur = field.frame(ph % 1.0 if st["steady"] else ph)
            jitter = st["jitter"]
            if jitter > 0 and not getattr(field, "NO_JITTER", False):
                for k in rng.sample(range(len(cur)), int(len(cur) * jitter)):
                    pos, gi, cid = cur[k]
                    if gi < 0:
                        continue
                    ng = min(NLUM - 1, max(0, gi + rng.choice((-2, -1, 1, 2))))
                    cur[k] = (pos, ng, cid - gi + ng)
            overlay, mask = "", (0, 0)
            if tune and hud:
                frames += 1
                if now - fps_t >= 1.0:
                    fps_seen, frames, fps_t = frames / (now - fps_t), 0, now
                stats = "%.0f fps" % fps_seen
                if hasattr(field, "coverage"):
                    stats += "   coverage %.0f%%" % (100 * field.coverage)
                if flash and now > flash_until:
                    flash = ""
                    prev = None
                overlay, n = draw_hud(style, st, sel, stats, flash)
                if n < hud_rows:
                    prev = None            # overlay shrank: repaint what it uncovered
                hud_rows = n
                mask = (n, HUD_W)
            chunk = render(cur, prev, cols, colors, getattr(field, "GLYPHS", RAMP), mask) + overlay
            if chunk:
                out.write(chunk)
                out.flush()
            prev = cur

            slack = 1.0 / max(1, st["fps"]) - (time.monotonic() - now)
            if slack > 0:
                time.sleep(slack)

    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        if saved is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write("\x1b[?7h\x1b[0m\x1b[?25h\x1b[?1049l")
        out.flush()


if __name__ == "__main__":
    main()
