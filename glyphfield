def params_for(style):
    return [p for p in PARAMS if p[2] is None or style in p[2]]


def load_config():
    try:
        with open(CONFIG, "rb") as fh:
            return tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def save_config(style, settings):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    lines = ["# glyphfield settings -- written by glyphfield --tune", 'style = "%s"' % style]
    for st in STYLES:
        lines.append("\n[%s]" % st)
        for k, v in settings[st].items():
            if isinstance(v, bool):
                lines.append("%s = %s" % (k, "true" if v else "false"))
            elif isinstance(v, float):
                lines.append("%s = %s" % (k, repr(round(v, 4))))
            else:
                lines.append("%s = %d" % (k, v))
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(tmp, CONFIG)


def make_field(style, cols, rows, aspect, st):
    klass = {"kaleido": Field, "mirror": Mirror, "bloom": Bloom}[style]
    opts = {k: st[k] for k in MIRROR_DEFAULTS} if style == "mirror" else None
    return klass(cols, rows, aspect, int(st["folds"]), st["scale"], int(st["pitch"]), opts)


def make_colors(style):
    if style == "mirror":
        return build_flat(MIRROR_COLORS, 0.25)
    if style == "bloom":
        return build_colors(BLOOM_STOPS, 0.6)
    return build_colors(STOPS)


