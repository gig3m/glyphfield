#!/usr/bin/env python3
"""glyphfield -- a full-screen field of glyphs painted by a morphing geometric pattern.

Every cell holds a character. Two slow interference fields drive it: one picks
the hue from a looping rainbow palette, the other picks the glyph's weight
(`.` through `@`) and its brightness. Radial rings, a kaleidoscope fold and a
rotating plane wave beat against each other, so rings, ovals and diamonds
swell, merge and dissolve across the screen. The clock wobbles at irrational
rates so the motion surges and never repeats; --steady gives an exact loop.

Three styles: kaleido (swirling kaleidoscope), mirror (beads streaming out of
a four-way mirror) and bloom (rings breathing from the centre).

Settings come from ~/.config/glyphfield/config.toml, then command-line flags.
--tune runs with a live settings overlay: adjust, watch, and save back to
that file. Otherwise exits on any keypress. Ctrl-C also works.
"""

import argparse
import math
import os
import random
import select
import signal
import sys
import termios
import time
import tomllib
import tty

# Light to heavy; the field's weight indexes into this.
RAMP = "+*oS0%8&@"

# Looping rainbow, as in the reference loop: gold, ember, rose, violet, azure,
# cyan, leaf, back to gold.
STOPS = ["#f7d83a", "#ff8a1f", "#ff3b5c", "#c63cff", "#3f7bff", "#22d3e6", "#58e05a"]

# Bloom runs outward from a hot core: rose, ember, gold (held wide), leaf,
# cyan, azure, violet, and wraps back to rose.
BLOOM_STOPS = ["#ff2f6d", "#ff5a2a", "#ffb21f", "#f5e04a", "#f5e04a",
               "#9be04a", "#2fd6d0", "#3a8bff", "#8a4bff"]

NHUE = 56
NLUM = len(RAMP)
TAU = 2 * math.pi


def parse_hex(s):
    s = s.lstrip("#")
    return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))


def build_colors(hexes, floor=0.45, cyclic=True):
    """SGR string per (hue, luminance) so the hot loop is a list index.

    Cyclic palettes wrap from the last stop back to the first; ramps run
    first to last and stop, so the hottest index is the last stop exactly."""
    stops = [parse_hex(h) for h in hexes]
    n = len(stops)
    table = []
    for h in range(NHUE):
        p = h / NHUE * n if cyclic else h / (NHUE - 1) * (n - 1)
        i = int(p)
        t = p - i
        a, b = stops[i % n], stops[(i + 1) % n]
        # smooth the blend so bands read as bands, not a linear smear
        t = t * t * (3 - 2 * t)
        base = [a[k] + (b[k] - a[k]) * t for k in range(3)]
        for l in range(NLUM):
            g = floor + (1 - floor) * (l / (NLUM - 1))
            table.append("\x1b[38;2;%d;%d;%dm" % tuple(int(c * g) for c in base))
    return table


def term_size():
    try:
        c = os.get_terminal_size()
        return c.columns, c.lines
    except OSError:
        return 80, 24


def wait_for_real_size(deadline=2.0):
    """A pty starts at 80x24 until the compositor sizes the window."""
    end = time.monotonic() + deadline
    while time.monotonic() < end and term_size() == (80, 24):
        time.sleep(0.02)


class Field:
    def __init__(self, cols, rows, aspect, folds, scale, pitch, opts=None):
        self.cols, self.rows = cols, rows
        # Normalise so the short side spans ~[-1, 1] in square units.
        w, h = cols / aspect, rows
        s = scale * 2.0 / min(w, h)
        cells = []
        for j in range(rows):
            for i in range(0, cols, pitch):
                x = ((i + 0.5) / aspect - w / 2) * s
                y = ((j + 0.5) - h / 2) * s
                r = math.hypot(x, y)
                a = math.atan2(y, x)
                # kaleidoscope: fold the angle into mirrored sectors
                k = (a / TAU * folds) % 1.0
                fa = abs(k - 0.5) * 2.0          # 0 at sector centre, 1 at seam
                cells.append((j * cols + i, x, y, r, fa))
        self.cells = cells

    def frame(self, ph):
        """ph: loop phase in [0, 1). Returns a list of (glyph index, colour index)."""
        sin, cos = math.sin, math.cos
        p = ph * TAU
        # rotating plane wave direction, completes one turn per loop
        dx, dy = cos(p), sin(p)
        # centre of a drifting second ring system, on a Lissajous path
        ox, oy = 0.55 * sin(p), 0.35 * sin(2 * p)
        out = []
        add = out.append
        for pos, x, y, r, fa in self.cells:
            r2 = math.hypot(x - ox, y - oy)
            hue_v = (sin(r * 2.6 - p)
                     + sin(r2 * 2.2 + 2 * p)
                     + 0.7 * sin((x * dx + y * dy) * 2.0 + p)
                     + 0.8 * cos(fa * 4.0 + r * 1.5 - 3 * p))
            lum_v = (cos(r * 4.0 - 2 * p)
                     + cos(r2 * 3.2 - p)
                     + cos(fa * 5.0 - r * 2.0 + p))
            hue = int(((hue_v * 0.16 + ph) % 1.0) * NHUE)
            l = lum_v / 3.0 * 0.5 + 0.5                 # 0..1
            l = l * l * (3 - 2 * l)                     # push to the extremes
            li = int(l * (NLUM - 1) + 0.5)
            add((pos, li, hue * NLUM + li))
        return out


class Bloom:
    """Four-way mirrored rounded-rectangle rings that breathe out from the
    centre, with per-cell colour and glyph jitter so it reads as a lit grid
    rather than a smooth gradient."""

    def __init__(self, cols, rows, aspect, folds, scale, pitch, opts=None):
        rnd = random.Random(1)
        cells = []
        for j in range(rows):
            for i in range(0, cols, pitch):
                # screen-shaped coordinates: the rings follow the display's
                # own proportions, so portrait and landscape both fill.
                u = abs((i + 0.5) / cols * 2 - 1) * scale
                v = abs((j + 0.5) / rows * 2 - 1) * scale
                d = (u ** 3 + v ** 3) ** (1 / 3)        # rounded rectangle
                a = math.atan2(v * rows, u * cols / aspect)
                cells.append((j * cols + i, u, v, d, a,
                              rnd.uniform(-1, 1),        # static hue jitter
                              rnd.uniform(0, TAU),       # glyph twinkle phase
                              rnd.randint(1, 3)))        # twinkle rate (loops)
        self.cells = cells
        self.folds = folds

    def frame(self, ph):
        sin, cos = math.sin, math.cos
        p = ph * TAU
        breathe = 0.12 * sin(p)
        f = self.folds / 2
        out = []
        add = out.append
        for pos, u, v, d, a, jit, tw, rate in self.cells:
            # corners swirl: the angular wobble twists with distance and time
            wob = 0.07 * cos(a * f * 2 + d * 5 - 2 * p) * d
            ring = d + wob - breathe
            # colour bands stream outward, two full cycles per loop
            hue = int(((ring * 0.62 - 2 * ph + jit * 0.07) % 1.0) * NHUE)
            # dark ripples: spiral bands that sweep out and blank the grid
            dark = 0.5 + 0.5 * sin(ring * 9 - 4 * p + 1.4 * cos(a * f - p))
            dark *= 0.6 + 0.4 * sin(ring * 3.5 - 2 * p + 2.0)
            lum = dark * (1.25 - 0.35 * ring) + 0.12 * sin(tw + rate * p)
            if lum < 0.16:
                add((pos, -1, 0))          # blank cell
                continue
            li = int(min(1.0, lum) * (NLUM - 1) + 0.5)
            add((pos, li, hue * NLUM + li))
        return out

# Mirror palette, measured off the reference loop: mostly white and cyan,
# then blue, azure, yellow, teal; pink and red only as rare sparks.
#          navy bg    blue       violet     teal       yellow     white      pink       red        cyan       azure
MIRROR_COLORS = ["#2a2fc8", "#3d5bff", "#8a5cff", "#2fd6a8", "#f2e24a", "#f4f4f4", "#ff5fb0", "#ff4040",
                 "#35d8f0", "#4a9cff"]
BG, BLUE, VIOLET, TEAL, YELLOW, WHITE, PINK, RED, CYAN, AZURE = range(10)
MIRROR_GLYPHS = "o8#G&@O%0+*."
# primary glyph and shimmer alternates per colour
MIRROR_SKIN = {
    BLUE: ("o", "O0"), VIOLET: ("@", "o0"), TEAL: ("8", "8@&"), CYAN: ("8", "8@0"),
    AZURE: ("0", "oO8"), YELLOW: ("#", "G8#"), WHITE: ("#", "G8@&"), PINK: ("&", "%G"),
    RED: ("*", "+*"),
}
# bead colour weights, measured off the reference loop
WEIGHT_KEYS = [("white", WHITE), ("cyan", CYAN), ("blue", BLUE), ("azure", AZURE),
               ("yellow", YELLOW), ("teal", TEAL), ("violet", VIOLET), ("pink", PINK),
               ("red", RED)]
MIRROR_DEFAULTS = {
    "beads": 22, "size_min": 0.04, "size_max": 0.075, "cells_min": 4, "cells_max": 14,
    "symmetry": 0.5, "ring": 0.22, "birth": 0.4,
    "w_white": 40, "w_cyan": 24, "w_blue": 9, "w_azure": 8, "w_yellow": 9,
    "w_teal": 5, "w_violet": 3, "w_pink": 1, "w_red": 1,
}


def build_flat(hexes, floor):
    """SGR per (colour, level): fixed colours, NLUM brightness steps each."""
    table = []
    for hx in hexes:
        base = parse_hex(hx)
        for l in range(NLUM):
            g = floor + (1 - floor) * (l / (NLUM - 1))
            table.append("\x1b[38;2;%d;%d;%dm" % tuple(int(c * g) for c in base))
    return table


class Mirror:
    """Kaleidoscope, built the way a real one is: the mirrors reflect a pile of
    beads. Each bead is a small cluster of identical glyphs in one colour,
    laid out in a random pixel pattern on a GxG grid. Beads are born at the
    centre, stream outward and swell toward the corners like an endless zoom,
    and every bead is painted four ways (eight with --folds 8), so colour
    comes in coherent patches that mix where beads meet.

    Rings of beads advance in s = log(r + R0): scrolling s is the zoom, and
    R0 gives the centre a real size so each ring is born as one overlapping,
    symmetric motif. Beads are hashed per ring, so nothing repeats."""

    GLYPHS = MIRROR_GLYPHS
    NO_JITTER = True       # shimmer here swaps within a bead's own glyph set
    RING = 0.22            # ring spacing in s
    R0 = 0.4               # log offset: size of the birth motif
    PER_RING = 22          # beads per ring across the quadrant
    SIZE = (0.04, 0.075)   # bead half-width as a fraction of (r + R0)
    G = 5                  # bead pattern grid

    def __init__(self, cols, rows, aspect, folds, scale, pitch, opts=None):
        o = dict(MIRROR_DEFAULTS, **(opts or {}))
        self.PER_RING = max(1, int(o["beads"]))
        self.SIZE = (o["size_min"], max(o["size_min"], o["size_max"]))
        self.RING = o["ring"]
        self.R0 = o["birth"]
        lo, hi = int(o["cells_min"]), int(o["cells_max"])
        self.ncells = (max(1, min(lo, hi)), min(self.G * self.G, max(lo, hi)))
        self.sym = o["symmetry"]
        self.deal = [c for name, c in WEIGHT_KEYS for _ in range(int(o["w_" + name]))] or [WHITE]
        rnd = random.Random(3)
        self.cols, self.rows, self.aspect, self.pitch = cols, rows, aspect, pitch
        self.w, self.h = cols / aspect, rows
        self.s = 1.0 / math.hypot(self.w / 2, self.h / 2)   # corners at r = 1
        self.diag = folds >= 8
        self.scale = scale
        self.nx = len(range(0, cols, pitch))
        self.bg = [(rnd.random(), rnd.uniform(0, TAU), rnd.randint(1, 3))
                   for _ in range(self.nx * rows)]
        self.birth = math.log(self.R0)
        self.smax = math.log(1.0 + self.R0) + 0.1
        self.cache = {}

    def pattern(self, rnd):
        """n cells grown as a random walk from the grid's centre, sometimes
        made mirror-symmetric so it reads as a cut crystal."""
        G = self.G
        n = rnd.randint(*self.ncells)
        cells = {(G // 2, G // 2)}
        pool = list(cells)
        while len(cells) < n:
            x, y = rnd.choice(pool)
            dx, dy = rnd.choice(((1, 0), (-1, 0), (0, 1), (0, -1), (1, 1), (-1, 1)))
            x, y = x + dx, y + dy
            if 0 <= x < G and 0 <= y < G and (x, y) not in cells:
                cells.add((x, y))
                pool.append((x, y))
        if rnd.random() < self.sym:
            cells |= {(G - 1 - x, y) for x, y in cells}
        return frozenset(cells)

    def ring(self, k):
        """Beads of ring k: (s offset, angle, size, pattern, colour, pulse)."""
        got = self.cache.get(k)
        if got is None:
            rnd = random.Random(k * 7919 + 17)
            n = self.PER_RING
            got = [(rnd.uniform(-0.5, 0.5) * self.RING,
                    (i + rnd.random()) / n * (math.pi / 2),
                    rnd.uniform(*self.SIZE),
                    self.pattern(rnd),
                    rnd.choice(self.deal),
                    rnd.uniform(0, TAU))
                   for i in range(n)]
            self.cache[k] = got
            if len(self.cache) > 64:
                self.cache.pop(min(self.cache))
        return got

    def frame(self, ph):
        sin, floor, exp = math.sin, math.floor, math.exp
        p = ph * TAU
        L = self.RING
        flow = ph * 3 * L / self.scale             # three rings stream out per cycle
        s, w, h, asp, pitch, nx, G = self.s, self.w, self.h, self.aspect, self.pitch, self.nx, self.G
        paint = [None] * (nx * self.rows)
        kmin = floor((self.birth - flow) / L) - 2
        kmax = floor((self.smax - flow) / L) + 2
        # inner rings first, so the bigger outer beads land on top
        for k in range(kmin, kmax + 1):
            for so, ang, size, pat, col, pp in self.ring(k):
                sb = k * L + so + flow
                if sb < self.birth or sb > self.smax:
                    continue
                rb = exp(sb) - self.R0
                half = size * (rb + self.R0) * (1.0 + 0.08 * sin(p * 2 + pp))
                bx, by = rb * math.cos(ang), rb * math.sin(ang)
                imgs = [(bx, by, 1, 1, False), (-bx, by, -1, 1, False),
                        (bx, -by, 1, -1, False), (-bx, -by, -1, -1, False)]
                if self.diag:
                    imgs += [(y, x, sy, sx, True) for x, y, sx, sy, _ in imgs]
                H = half / s
                for x, y, sx, sy, swap in imgs:
                    X, Y = x / s + w / 2, y / s + h / 2
                    j0, j1 = max(0, int(Y - H)), min(self.rows - 1, int(Y + H) + 1)
                    i0 = max(0, int((X - H) * asp) // pitch)
                    i1 = min(nx - 1, int((X + H) * asp) // pitch + 1)
                    for j in range(j0, j1 + 1):
                        dy = (j + 0.5 - Y) / H * sy
                        if dy <= -1.0 or dy >= 1.0:
                            continue
                        row = j * nx
                        for i in range(i0, i1 + 1):
                            dx = ((i * pitch + 0.5) / asp - X) / H * sx
                            if dx <= -1.0 or dx >= 1.0:
                                continue
                            gx, gy = int((dx + 1) * G / 2), int((dy + 1) * G / 2)
                            if swap:
                                gx, gy = gy, gx
                            if (gx, gy) in pat:
                                paint[row + i] = col
        out = []
        add = out.append
        top = NLUM - 1
        nlit = 0
        cols = self.cols
        for idx, col in enumerate(paint):
            pos = (idx // nx) * cols + (idx % nx) * pitch
            spark, tw, rate = self.bg[idx]
            glow = 0.5 + 0.5 * sin(tw + rate * p)
            if col is not None:
                nlit += 1
                prim, alts = MIRROR_SKIN[col]
                ch = prim if spark > 0.2 * glow else alts[int(spark * 97) % len(alts)]
                add((pos, MIRROR_GLYPHS.index(ch), col * NLUM + int((0.78 + 0.22 * glow) * top)))
            elif spark > 0.3 + 0.3 * glow:
                add((pos, -1, 0))
            else:
                add((pos, 0, BG * NLUM + int((0.08 + 0.18 * glow) * top)))
        self.coverage = nlit / len(paint)
        return out


def render(cur, prev, cols, colors, glyphs=RAMP, mask=(0, 0)):
    """Diff-draw the field. mask = (rows, cols) of a top-left panel the field
    never paints under, so an overlay drawn there cannot flicker."""
    buf = []
    add = buf.append
    last = -2
    last_cid = -1
    mrows, mcols = mask
    for k, cell in enumerate(cur):
        if prev is not None and prev[k] == cell:
            continue
        idx, gi, cid = cell
        if mrows and idx // cols < mrows and idx % cols < mcols:
            last = -2
            continue
        if idx != last + 1:
            add("\x1b[%d;%dH" % (idx // cols + 1, idx % cols + 1))
        if gi < 0:
            add(" ")
            last = idx
            continue
        if cid != last_cid:
            add(colors[cid])
            last_cid = cid
        add(glyphs[gi])
        last = idx
    return "".join(buf)


