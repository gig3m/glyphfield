#!/bin/bash
#
# After each Omarchy update, keep glyphfield's screensaver hookup current.
#
# - If Omarchy's idle service now reads idle.screensaverCommand
#   (omacom/omarchy#10483), switch to that: set the key, hand idle duty back to
#   the stock service, and park the old clone. Nothing to maintain after that.
# - Otherwise re-copy the packaged idle service over glyphfield's <user>.idle
#   clone and re-apply the launcher swap, so the clone keeps upstream fixes and
#   only ever differs from stock by that one command.
#
# Installed as a symlink into ~/.config/omarchy/hooks/post-update.d/.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
# shellcheck source=../../lib/omarchy.sh
source "$REPO_DIR/lib/omarchy.sh"

notify() { omarchy-notification-send "$@" >/dev/null 2>&1 || true; }

clone=$(our_clone)
[[ -n $clone && -d $STOCK_IDLE ]] || exit 0

if supports_screensaver_command; then
  set_screensaver_command || {
    notify -u critical -g 󰅚 "glyphfield screensaver needs attention" \
      "Could not set idle.screensaverCommand in shell.json; re-run glyphfield's install.sh."
    exit 0
  }
  retire_clone >/dev/null
  restart_shell || true
  notify -g 󰅐 "glyphfield: switched to idle.screensaverCommand" \
    "Omarchy can now launch glyphfield directly; the $(basename "$clone") clone is parked."
  exit 0
fi

if ! sync_clone "$clone"; then
  # Never install a copy that no longer calls our launcher: if upstream changes
  # how it starts the screensaver, say so instead.
  notify -u critical -g 󰅚 "glyphfield screensaver needs attention" \
    "Omarchy's idle service changed shape; re-run glyphfield's install.sh."
  exit 0
fi

# A changed keepLoaded service only takes effect on a shell restart.
if ((${#SYNCED[@]})); then
  restart_shell || true
  notify -g 󰅐 "glyphfield: idle service re-synced" \
    "Picked up Omarchy's changes to ${SYNCED[*]}."
fi
